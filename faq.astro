---
import SiteLayout from '../layouts/SiteLayout.astro';
import faq from '../data/faq.json';
const title = 'Sahabeler ve Asr-ı Saadet Hakkında Sorular';
const description = 'Sahabeler, Asr-ı Saadet dönemi, siyer kaynakları ve portalın kullanımı hakkında sık sorulan soruların yanıtlarını okuyun.';
const canonical = new URL('/faq', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
const no = (i) => String(i + 1).padStart(2, '0');
---
<SiteLayout page="faq" {title} {description} {canonical} {jsonLd}>
  <main class="faq-page">
    <section class="page-hero">
      <nav class="page-crumbs" aria-label="breadcrumb"><a href="/">Ana Sayfa</a><span>›</span><span aria-current="page">Sıkça Sorulan Sorular</span></nav>
      <p class="page-eyebrow"><span></span>Yardım</p>
      <h1>Sıkça Sorulan Sorular</h1>
      <p class="page-lead">Portalın kapsamı, kaynakları ve kullanımı hakkında merak edilenler.</p>
    </section>
    <div class="faq-layout">
      <div class="faq-v2-list">
        {faq.map(([question, answer], i) => (
          <details class="faq-v2" id={`sss-${i}`}>
            <summary><span class="faq-v2-no">{no(i)}</span><span class="faq-v2-q">{question}</span><span class="faq-v2-toggle" aria-hidden="true"></span></summary>
            <div class="faq-v2-a"><p>{answer}</p></div>
          </details>
        ))}
      </div>
      <aside class="faq-aside">
        <div class="faq-aside-card">
          <p class="page-eyebrow"><span></span>İletişim</p>
          <h2>Sorunuzu bulamadınız mı?</h2>
          <p>Önerilerinizi, düzeltme bildirimlerinizi ve sorularınızı bize yazabilirsiniz.</p>
          <a class="button primary" href="/contribute">Bize yazın</a>
          <a class="faq-aside-link" href="/search">Portalda ara →</a>
        </div>
      </aside>
    </div>
  </main>
  <script is:inline>
    (function () {
      function ac() {
        var id = decodeURIComponent((location.hash || '').slice(1));
        var el = id && document.getElementById(id.indexOf('sss-') === 0 ? id : 'sss-' + id);
        if (el && el.tagName === 'DETAILS') { el.open = true; el.scrollIntoView({ block: 'start' }); }
      }
      ac();
      window.addEventListener('hashchange', ac);
    })();
  </script>
</SiteLayout>
