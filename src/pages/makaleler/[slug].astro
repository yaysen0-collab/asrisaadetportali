---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { makaleleriGetir, makaleGorseli, kaynakListesi } from '../../data/makaleler.mjs';

export function getStaticPaths() {
  return makaleleriGetir().map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const canonical = new URL(`/makaleler/${article.slug}`, Astro.site).href;
const title = `${article.baslik} | Asr-ı Saadet Portalı`;
const description = (article.ozet || '').slice(0, 155);
const heroImage = makaleGorseli(article, 1600);
const kaynaklar = kaynakListesi(article);
const plainText = article.govde.replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
const readingMinutes = Math.max(1, Math.ceil(plainText.split(' ').filter(Boolean).length / 220));
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: article.baslik,
      description,
      articleSection: article.etiket,
      mainEntityOfPage: canonical,
      publisher: { '@type': 'Organization', name: 'Asr-ı Saadet Portalı', url: new URL('/', Astro.site).href },
      image: article.gorsel ? undefined : makaleGorseli(article, 1100),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Makaleler', item: new URL('/articles', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: article.baslik, item: canonical },
      ],
    },
  ],
};
---
<SiteLayout page="articles" {title} {description} {canonical} {jsonLd}>
  <main class="article-page">
    <nav class="article-crumbs" aria-label="breadcrumb"><a href="/">Ana Sayfa</a><span>›</span><a href="/articles">Makaleler</a><span>›</span><span aria-current="page">{article.baslik}</span></nav>
    <header class="article-hero">
      <div class="article-hero-image"><img src={heroImage} alt="" fetchpriority="high" /></div>
      <div class="article-hero-content">
        <p class="article-kicker"><span></span>{article.etiket}</p>
        <h1>{article.baslik}</h1>
        <p class="article-deck">{article.ozet}</p>
        <div class="article-byline"><span class="article-brand-mark">AS</span><span>Asr-ı Saadet Portalı</span><i></i><span>{readingMinutes} dk okuma</span></div>
      </div>
    </header>
    <div class="article-reading-layout">
      <aside class="article-aside"><div class="article-aside-card"><span class="article-aside-label">Bu yazı</span><strong>{article.etiket}</strong><span class="article-aside-rule"></span><span class="article-aside-label">Tahmini okuma</span><strong>{readingMinutes} dakika</strong><a href="/articles">Tüm makaleler <span>↗</span></a></div></aside>
      <article class="article-body" aria-label={article.baslik}>
        <div class="article-full" set:html={article.govde} />
        {kaynaklar.length > 0 && (
          <section class="article-sources" aria-label="Kaynaklar">
            <h2>Kaynaklar</h2>
            <ol>{kaynaklar.map((k) => <li>{k}</li>)}</ol>
          </section>
        )}
        <div class="article-endmark" aria-hidden="true"><span></span> ASR-I SAADET <span></span></div>
        <a class="article-back" href="/articles"><span>←</span> Makalelere dön</a>
      </article>
    </div>
  </main>
</SiteLayout>

