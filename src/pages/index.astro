---
import SiteLayout from '../layouts/SiteLayout.astro';
import { makaleleriGetir } from '../data/makaleler.mjs';
const articles = makaleleriGetir();
const title = 'Sahabe Hayatları ve İslam Tarihi | Asr-ı Saadet Portalı';
const description = 'Sahabe hayatlarını, akrabalık bağlarını ve Asr-ı Saadet dönemindeki önemli olayları güvenilir siyer kaynaklarıyla keşfedin.';
const canonical = new URL('/', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', name: 'Asr-ı Saadet Portalı', url: canonical },
    { '@type': 'WebSite', name: 'Asr-ı Saadet Portalı', url: canonical, inLanguage: 'tr' },
  ],
};
---
<SiteLayout page="home" {title} {description} {canonical} {jsonLd} legacyApp={true} preloadHero>
  <main id="app" aria-live="polite">
    <section class="split">
      <div class="half visual">
        <img src="https://images.unsplash.com/photo-1776893761976-03f46ce701df?w=1400&q=70&auto=format&fit=crop" alt="Cami kubbesinin iç mimarisi" fetchpriority="high" />
        <div class="visual-content"><h1>“Ashabım, yıldızlar gibidir. Hangisine tabi olursanız hidayete erersiniz.”</h1><p class="quote-source">— Peygamber Efendimiz (s.a.v.)</p><div class="brass-rule"></div></div>
      </div>
      <div class="half content">
        <p class="eyebrow">Dijital Siyer Arşivi</p>
        <h2 class="content-title">Ashab-ı Kiram'ın hayatlarını, nesep bağlarını ve dönemin olaylarını tek yerde okuyun.</h2>
        <p class="lead">Kayıtlar klasik siyer ve tarih kaynaklarına dayanır. Bir şahsiyetten akrabalarına, bir olaydan zaman çizelgesindeki yerine geçebilirsiniz.</p>
        <div class="actions"><a class="button primary" href="/archive">Arşivi Keşfet</a><a class="button" href="/timeline">Zaman Çizelgesi</a></div>
      </div>
    </section>
    <section class="split short">
      <div class="half content dark-content"><p class="eyebrow">Temel Okumalar</p><h2 class="serif-title">Ashab-ı Kiram'ı ve ilim geleneğini anlatan okumalar.</h2><p class="lead">İtikat, ilim ve Kur'an eğitimi üzerine hazırlanmış yazılar.</p><a class="text-link" href="/articles">Makaleleri oku →</a></div>
      <div class="half content"><div class="article-lines">{articles.map((article) => <div class="article-line"><span class="article-tag">{article.etiket}</span><p><a href={`/makaleler/${article.slug}`}>{article.baslik}</a></p></div>)}</div></div>
    </section>
  </main>
</SiteLayout>

