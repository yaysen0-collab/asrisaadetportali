---
import SiteLayout from '../layouts/SiteLayout.astro';
import { makaleleriGetir, makaleGorseli } from '../data/makaleler.mjs';
const articles = makaleleriGetir();
const title = 'Siyer, Sahabe ve İslam Tarihi Makaleleri | Asr-ı Saadet';
const description = 'Siyer, sahabe hayatları, Kur’an eğitimi ve İslam ilim geleneği üzerine hazırlanmış makaleleri okuyun.';
const canonical = new URL('/articles', Astro.site).href;
---
<SiteLayout page="articles" {title} {description} {canonical} legacyApp={true}>
  <main id="app" aria-live="polite">
    <section class="page-hero">
      <nav class="page-crumbs" aria-label="breadcrumb"><a href="/">Ana Sayfa</a><span>›</span><span aria-current="page">Makaleler</span></nav>
      <p class="page-eyebrow"><span></span>Temel Okumalar</p>
      <h1>Siyer ve ilim geleneği üzerine makaleler</h1>
      <p class="page-lead">Ashab-ı Kiram, İslam tarihi ve ilim geleneği üzerine hazırlanan yazıları okuyun.</p>
    </section>
    <section class="article-grid" aria-label="Makale listesi">
      {articles.map((article) => (
        <a class="article-card" href={`/makaleler/${article.slug}`}>
          <span class="article-card-image"><img src={makaleGorseli(article, 900)} alt="" loading="lazy" /></span>
          <span class="article-card-body">
            <span class="article-card-tag">{article.etiket}</span>
            <span class="article-card-title">{article.baslik}</span>
            <span class="article-card-text">{article.ozet}</span>
            <span class="article-card-more">Makaleyi oku →</span>
          </span>
        </a>
      ))}
    </section>
  </main>
</SiteLayout>
