# Copy these into Vercel → Project → Settings → Environment Variables (not into Git).

# Public address of the site. Overrides site.config.json — set this when the custom domain goes live.
SITE_URL=https://asrisaadetportali.vercel.app

# Preferred: the whole Firebase service-account JSON on one line (Firebase Console →
# Project settings → Service accounts → Generate new private key).
FIREBASE_SERVICE_ACCOUNT=

# Fallback when no service account is set (reads the public collections over REST).
FIREBASE_PROJECT_ID=tarihizatlar
